---
import { Image } from "astro:assets";
import { asset } from "../lib/assets";
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  poster?: boolean;
}
const {
  name,
  alt,
  class: className = "",
  eager = false,
  poster = false,
} = Astro.props;
---

<Image
  src={asset(name)}
  width={Math.min(asset(name).width, poster ? 800 : 1200)}
  alt={alt}
  widths={poster ? [400, 800] : [400, 800, 1200]}
  sizes="(max-width: 700px) 92vw, (max-width: 1000px) 70vw, 600px"
  format="webp"
  quality={80}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  class:list={[className, { poster }]}
/>
