---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Photo from "../components/Photo.astro";
import JoinBanner from "../components/JoinBanner.astro";
import { url } from "../lib/site";
const events = await getCollection(
  "events",
  ({ data }) => !data.draft && data.cover !== data.poster,
);
---

<Layout title="Gallery"
  ><section class="page-intro wrap">
    <span class="eyebrow">Life at CSS</span><h1>
      Same curiosity.<br /><span class="blue">Shared memories.</span>
    </h1><p>
      A glimpse of the people, places and experiences that make our community.
    </p>
  </section><section
    class="wrap section gallery-grid"
    aria-label="Event photographs"
  >
    {
      events.map((e, i) => (
        <figure class:list={["gallery-item", { "gallery-wide": i === 0 }]}>
          <>
            <a
              href={e.data.albumUrl || url(`events/${e.id}/`)}
              target={e.data.albumUrl ? "_blank" : undefined}
              rel={e.data.albumUrl ? "noopener noreferrer" : undefined}
            >
              <>
                <Photo
                  name={e.data.cover}
                  alt={e.data.coverAlt}
                  eager={i === 0}
                />
                <span class="photo-arrow" aria-hidden="true">
                  ↗
                </span>
              </>
            </a>
            <figcaption>
              <>
                <div>
                  <>
                    <span class="eyebrow">{e.data.category}</span>
                    <h2>{e.data.title}</h2>
                  </>
                </div>
                <a
                  class="text-link"
                  href={e.data.albumUrl || url(`events/${e.id}/`)}
                  target={e.data.albumUrl ? "_blank" : undefined}
                  rel={e.data.albumUrl ? "noopener noreferrer" : undefined}
                >
                  {e.data.albumUrl ? "Google Photos ↗" : "View event ↗"}
                </a>
              </>
            </figcaption>
          </>
        </figure>
      ))
    }
  </section><JoinBanner /></Layout
>
