---
import Layout from "../layouts/Layout.astro";
import { url } from "../lib/site";
---

<Layout title="Page not found" noindex
  ><section class="wrap not-found">
    <span class="eyebrow">404 / A small detour</span><h1>
      Let's get you<br /><span class="blue">back on track.</span>
    </h1><p>This page doesn't exist, but there's plenty to explore.</p><div
      class="button-row"
    >
      <a class="button" href={url()}>Back to home ↗</a><a
        class="button button-outline"
        href={url("events/")}>Explore events ↗</a>
    </div>
  </section></Layout
>
