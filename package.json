{
  "name": "tarumt-css",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "tsx --test tests/*.test.ts",
    "test:build": "node scripts/check-build.mjs",
    "format": "prettier --write --plugin=prettier-plugin-astro src tests scripts *.mjs *.json docs/*.md README.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/space-grotesk": "5.3.0",
    "astro": "7.3.8",
    "css-tree": "^3.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
